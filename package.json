{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend Barbearia API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "db:validate-schema": "node scripts/validate-schema.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:system:300": "node scripts/system-300.js",
    "test:catalog": "node scripts/ai-test-executor.js",
    "test:catalog:plan": "node scripts/ai-test-executor.js --dry-run --no-support-suites",
    "test:flutter:e2e": "node scripts/run-flutter-catalog-e2e.js",
    "test:flutter:buttons": "node scripts/run-flutter-catalog-e2e.js --button-audit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
